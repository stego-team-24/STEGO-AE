generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Map {
  id          String     @id @default(uuid())
  title       String
  authorName  String
  gridSize    Int        @default(15)
  templateId  String
  walls       Json       @default("[]")
  entryBriefing String   @default("")
  entranceX   Int
  entranceY   Int
  treasureX   Int
  treasureY   Int
  shadows     Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String?
  author      User?      @relation("MapAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  clueNodes   ClueNode[]
  gameResults GameResult[]
}

model ClueNode {
  id           String    @id @default(uuid())
  mapId        String
  map          Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  nodeOrder    Int
  coordX       Int
  coordY       Int
  mediaType    MediaType
  mediaMime    String
  coverData    Bytes
  mediaData    Bytes
  passphrase   String
  secretOutput String
  psnrDb       Float?
  mse          Float?
  createdAt    DateTime  @default(now())
  solves       ClueSolve[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  displayName  String
  passwordHash String
  createdAt    DateTime     @default(now())
  maps         Map[]        @relation("MapAuthor")
  clueSolves   ClueSolve[]
  gameResults  GameResult[]
}

model ClueSolve {
  id       String   @id @default(uuid())
  userId   String
  clueId   String
  extractedText String
  solvedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clue     ClueNode @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@unique([userId, clueId])
  @@index([userId, solvedAt])
}

model GameResult {
  id               String   @id @default(uuid())
  runId            String   @unique
  userId           String
  mapId            String
  completedAt      DateTime @default(now())
  elapsedSeconds   Int
  wrongPassphrases Int
  detections       Int
  score            Int
  rank             String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  map              Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([mapId, userId])
}

enum MediaType {
  IMAGE
  AUDIO
}
